# Variabile de mediu opționale. Aplicația nu folosește secrete.
# Pe Windows (PowerShell) se setează așa:  $env:PORT=3001; npm start

# Portul HTTP. Serviciile de găzduire îl setează singure.
PORT=3000

# Interfața pe care ascultă serverul. 0.0.0.0 = toate (necesar pentru rețeaua locală și găzduire).
HOST=0.0.0.0

# 1 = aplicația rulează în spatele unui proxy (Render etc.); limitările pe IP folosesc X-Forwarded-For.
# Lasă 0 când rulezi local, altfel oricine ar putea falsifica adresa.
TRUST_PROXY=0

# Doar dacă interfața este găzduită pe alt domeniu decât serverul (nu e cazul implicit).
# Listă separată prin virgulă, ex.: https://ludo.example.com
ALLOWED_ORIGINS=
